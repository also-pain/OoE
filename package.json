{
  "name": "ooe_scaffold",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "expo": "~58.0.26",
    "expo-auth-session": "~58.0.19",
    "expo-crypto": "~58.0.8",
    "expo-image-picker": "~58.0.10",
    "expo-notifications": "~58.1.9",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.10",
    "@types/react": "~19.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "export:all": "expo export --platform android --platform ios",
    "export:web": "expo export --platform web",
    "build:android:apk": "npx eas-cli build --platform android --profile preview",
    "build:android:aab": "npx eas-cli build --platform android --profile production",
    "build:ios": "npx eas-cli build --platform ios --profile production",
    "build:all": "npx eas-cli build --platform all --profile preview"
  },
  "private": true
}
